
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MediLink Team Performance Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f1f5f9;
            color: #1e293b;
            padding: 25px;
        }

        header {
            background: #164e63;
            color: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        header h1 {
            margin-bottom: 8px;
        }

        header p {
            color: #cbd5e1;
        }

        .subtitle {
            margin: 15px 0;
            color: #475569;
        }

        .dashboard {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 22px;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.06);
            border-left: 5px solid #0891b2;
        }

        .card h3 {
            font-size: 16px;
            color: #475569;
            margin-bottom: 15px;
        }

        .value {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .target {
            font-size: 13px;
            color: #64748b;
        }

        .status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            margin-top: 12px;
        }

        .good {
            background: #dcfce7;
            color: #166534;
        }

        .warning {
            background: #fef3c7;
            color: #92400e;
        }

        .bad {
            background: #fee2e2;
            color: #991b1b;
        }

        .section {
            background: white;
            padding: 22px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        }

        .section h2 {
            color: #164e63;
            margin-bottom: 18px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 14px;
            border-bottom: 1px solid #e2e8f0;
            text-align: left;
            vertical-align: top;
            line-height: 1.5;
        }

        th {
            background: #e0f2fe;
            color: #164e63;
        }

        tr:hover {
            background: #f8fafc;
        }

        .notice {
            background: #ecfeff;
            border-left: 5px solid #0891b2;
            padding: 18px;
            border-radius: 8px;
            line-height: 1.6;
        }

        footer {
            text-align: center;
            color: #64748b;
            margin-top: 25px;
            font-size: 13px;
        }

        @media (max-width: 900px) {
            .dashboard {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            body {
                padding: 12px;
            }

            .dashboard {
                grid-template-columns: 1fr;
            }

            .section {
                overflow-x: auto;
            }

            table {
                min-width: 750px;
            }
        }
    </style>
</head>

<body>

<header>
    <h1> MediLink Team Dashboard</h1>
    <p>Engineering Performance and Quality Monitoring</p>
    <p>Reporting Period: November 2026</p>
</header>

<p class="subtitle">
    This dashboard measures team delivery, software quality,
    workflow efficiency, and process consistency.
</p>

<!-- PERFORMANCE INDICATORS -->

<div class="dashboard">

    <div class="card">
        <h3>Delivery Reliability</h3>
        <div class="value">92%</div>
        <p class="target">Target: 90% or higher</p>
        <span class="status good">On Target</span>
    </div>

    <div class="card">
        <h3>First-Time-Right (FTR)</h3>
        <div class="value">85%</div>
        <p class="target">Target: 90% or higher</p>
        <span class="status warning">Needs Improvement</span>
    </div>

    <div class="card">
        <h3>Review Turnaround</h3>
        <div class="value">18 Hours</div>
        <p class="target">Target: 24 hours or less</p>
        <span class="status good">On Target</span>
    </div>

    <div class="card">
        <h3>Blocked Work</h3>
        <div class="value">8%</div>
        <p class="target">Target: 5% or less</p>
        <span class="status warning">Needs Attention</span>
    </div>

    <div class="card">
        <h3>Checklist Compliance</h3>
        <div class="value">96%</div>
        <p class="target">Target: 95% or higher</p>
        <span class="status good">On Target</span>
    </div>

    <div class="card">
        <h3>Defect / Rework Rate</h3>
        <div class="value">12%</div>
        <p class="target">Target: 10% or less</p>
        <span class="status warning">Needs Improvement</span>
    </div>

</div>

</body>
</html>
